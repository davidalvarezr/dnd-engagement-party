{
    "name": "dnd-engagement-party",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.15.1",
    "scripts": {
        "postinstall": "prisma generate",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "format": "biome format --write",
        "format:check": "biome format .",
        "test": "vitest run",
        "db:up": "db",
        "db:migrate": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "next": "16.2.5",
        "pg": "^8.20.0",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.0",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "dotenv": "^17.4.2",
        "prisma": "^7.8.0",
        "qrcode": "^1.5.4",
        "sharp": "^0.34.5",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "vitest": "^4.1.10"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
